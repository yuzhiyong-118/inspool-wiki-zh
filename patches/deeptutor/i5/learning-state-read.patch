+@router.get("/books/{book_id}/learning-state")
+async def get_book_learning_state(book_id: str) -> dict[str, Any]:
+    """Persisted reader observations; no UI defaults, writes or generation."""
+    from deeptutor.book.learning_state_read import BookStateUnavailable, read_learning_state
+    from deeptutor.services.workspace.context import current_workspace_id
+
+    resolved = _resolve_book_or_404(book_id)
+    try:
+        value = await asyncio.to_thread(read_learning_state, resolved, book_id)
+    except BookStateUnavailable as exc:
+        raise HTTPException(status_code=409, detail={"code": "book_state_unavailable", "observation": exc.item}) from None
