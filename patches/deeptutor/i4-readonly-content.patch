+@router.get("/books/{book_id}/content")
+async def get_book_content(book_id: str) -> dict[str, Any]:
+    """Content evidence read: no resume, progress, chat or generation writes."""
+    resolved = _resolve_book_or_404(book_id)
+    engine = resolved.engine
+
+    def _read() -> dict[str, Any]:
+        book = engine.load_book(book_id)
+        if book is None:
+            raise HTTPException(status_code=404, detail="Book not found")
+        spine = engine.load_spine(book_id)
+        pages, enumeration = engine.storage.list_pages_strict(book_id)
+        errors = enumeration["errors"]
+        ids = {page.id for page in pages}
+        if spine is None or spine.book_id != book_id:
+            errors.append({"code": "spine_missing_or_invalid"})
+        else:
+            for chapter in spine.chapters:
+                for page_id in chapter.page_ids:
+                    if page_id not in ids:
+                        errors.append({"code": "referenced_page_missing"})
+        for page in pages:
+            refs = [link.target_page_id for link in page.links]
+            if page.parent_page_id:
+                refs.append(page.parent_page_id)
+            if any(ref not in ids for ref in refs):
+                errors.append({"code": "referenced_page_missing"})
+        if book.page_count != len(pages):
+            errors.append({"code": "manifest_page_count"})
+        payload = book.model_dump(mode="json")
+        # Canonical manifests can contain the owner's chat mapping. A shared
+        # reader gets content, never that mapping or another learning overlay.
+        payload.pop("chat_session_id", None)
+        metadata = dict(payload.get("metadata") or {})
+        metadata.pop("page_chat_sessions", None)
+        payload["metadata"] = metadata
+        payload.update(resolved.capabilities())
+        return {"schema": "book-content-read/1", "book": payload,
+                "spine": spine.model_dump(mode="json") if spine else None,
+                "pages": [page.model_dump(mode="json") for page in pages],
+                "generation": engine.generation_summary(book_id, book=book, pages=pages),
+                "pageEnumeration": enumeration}
+
+    return await asyncio.to_thread(_read)
 
 
