+++ b/deeptutor/book/generation.py
@@ -0,0 +1,99 @@
+"""Single-worker generation lifecycle, committed with the native page JSON.
+
+The visible payload remains the last complete page on failure/interruption.
+The bounded previous snapshot exists only while work is active; no progress or
+submission is copied here, and opening a page never replays a model request.
+"""
+from __future__ import annotations
+
+import asyncio
+from functools import wraps
+import hashlib
+from inspect import signature
+import json
+import time
+import uuid
+
+from .models import Page
+
+PROCESS_EPOCH = uuid.uuid4().hex
+
+
+def generation_state(page):
+    return (page.__pydantic_extra__ or {}).get('generation') or {}
+
+
+def recover_page(page):
+    marker = generation_state(page)
+    if marker.get('state') != 'running' or marker.get('executor') == PROCESS_EPOCH:
+        return page, False
+    marker = dict(marker)
+    previous = marker.pop('lastComplete', None)
+    if previous:
+        page = Page.model_validate(previous)
+    marker.update(state='interrupted', finishedAt=time.time(), reason='executor_lost',
+                  showingLastComplete=bool(previous), transportResult='unknown')
+    page.generation = marker
+    return page, True
+
+
+def track_generation(function):
+    @wraps(function)
+    async def tracked(self, *args, **kwargs):
+        bound = signature(function).bind(self, *args, **kwargs).arguments
+        book_id, page_id = bound['book_id'], bound['page_id']
+        page = self.storage.load_page(book_id, page_id)
+        if page is None:
+            return await function(self, *args, **kwargs)
+        if function.__name__ == '_compile_page_now' and page.status.value=='ready' and not bound.get('force'):
+            return await function(self, *args, **kwargs)
+        old = generation_state(page)
+        if old.get('state') == 'running':
+            raise ValueError('generation_busy: page already has an active writer')
+        complete = page.status.value=='ready' or (function.__name__=='regenerate_block' and
+            page.block_by_id(bound.get('block_id','')) is not None and
+            page.block_by_id(bound['block_id']).status.value=='ready')
+        previous = page.model_dump(mode='json', exclude={'generation'}) if complete else None
+        semantic = {k:v for k,v in bound.items() if k not in {'self','stream'}}
+        operation = uuid.uuid4().hex
+        marker = dict(operationId=operation, kind=function.__name__, bookId=book_id, pageId=page_id,
+            blockId=bound.get('block_id'), inputDigest=hashlib.sha256(json.dumps(semantic, sort_keys=True,
+                ensure_ascii=False, allow_nan=False).encode()).hexdigest(), startedAt=time.time(),
+            state='running', executor=PROCESS_EPOCH,
+            retryOf=old.get('operationId') if old.get('state') in {'failed','cancelled','interrupted'} else None,
+            previousOperationId=old.get('operationId'),
+            showingLastComplete=bool(previous), lastComplete=previous, transportResult='unknown')
+        page.generation = marker
+        self.storage.save_page(page)
+        from deeptutor.services.llm.metrics import current_usage, TurnUsage
+        parent = current_usage.get()
+        token = current_usage.set(TurnUsage(session_id=parent.session_id if parent else '',
+            turn_id=operation, source='book:'+function.__name__))
+        outcome, reason, result = 'failed', 'generation_incomplete', None
+        try:
+            result = await function(self, *args, **kwargs)
+            if result is not None and result.status.value=='ready':
+                outcome, reason = 'completed', ''
+            return result
+        except asyncio.CancelledError:
+            outcome, reason = 'cancelled', 'execution_cancelled'
+            raise
+        except BaseException:
+            reason = 'generation_failed'
+            raise
+        finally:
+            current_usage.reset(token)
+            latest = self.storage.load_page(book_id, page_id)
+            if latest is not None and generation_state(latest).get('operationId') == operation:
+                if outcome != 'completed' and previous:
+                    latest = Page.model_validate(previous)
+                marker.pop('lastComplete', None)
+                marker.update(state=outcome, reason=reason, finishedAt=time.time(),
+                              showingLastComplete=outcome!='completed' and bool(previous))
+                latest.generation = marker
+                if isinstance(result, Page):
+                    result.generation = marker
+                # Completion and visible payload share this one atomic write.
+                self.storage.save_page(latest)
+                self.storage.append_log(book_id, f'{operation}: {outcome} ({reason})', op='generation')
+    return tracked
