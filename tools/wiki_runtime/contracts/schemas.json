        "required_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3",
              "G4",
              "G5"
            ]
          },
          "minItems": 0
        },
        "authorization_refs": {
