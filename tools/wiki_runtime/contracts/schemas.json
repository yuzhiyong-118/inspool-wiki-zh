        "source": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "published_at": {
              "type": "string"
            },
            "acquired_at": {
              "type": "string",
              "minLength": 1
            },
            "unavailable_fields": {
              "type": "array",
