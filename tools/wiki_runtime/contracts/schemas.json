{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inspool:runtime:contracts:1.0",
  "$defs": {
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "absent"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "hash"
            },
            "sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "kind",
            "sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "format": "vault-path"
        },
        "sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "dependencies_digest": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "rules_digest": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "mapping_digest": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "validator_version": {
          "type": "string",
          "minLength": 1
        },
        "review_prompt_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operation_id",
        "candidate_digest",
        "dependencies_digest",
        "rules_digest",
        "mapping_digest",
        "validator_version",
        "review_prompt_version"
      ],
      "additionalProperties": false
    },
    "source_package": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0"
