                      "kind",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "action",
                  "path",
                  "precondition"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "move"
                  },
                  "source": {
                    "type": "string",
                    "format": "vault-path"
                  },
                  "source_sha256": {
                    "type": "string",
                    "pattern": "[0-9a-f]{64}"
                  },
                  "path": {
                    "type": "string",
                    "format": "vault-path"
                  },
                  "precondition": {
                    "type": "object",
                    "properties": {
                      "kind": {
