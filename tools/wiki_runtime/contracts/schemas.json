        "locators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "block_id": {
                "type": "string",
                "minLength": 1
              },
              "artifact_path": {
                "type": "string",
                "format": "vault-path"
              },
              "location": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "block_id",
              "artifact_path",
              "location"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "parser": {
          "type": "object",
          "properties": {
            "adapter_id": {
              "type": "string",
              "minLength": 1
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1
            },
            "parser_version": {
              "type": "string",
              "minLength": 1
            },
            "config_digest": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            },
            "used_ocr": {
              "type": "boolean"
            },
            "used_model": {
              "type": "boolean"
            }
          },
          "required": [
            "adapter_id",
            "adapter_version",
            "parser_version",
            "config_digest",
            "used_ocr",
            "used_model"
          ],
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "failed"
              ]
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "statistics": {
              "type": "object",
              "properties": {
                "blocks": {
                  "type": "integer",
                  "minimum": 0
                },
                "characters": {
                  "type": "integer",
                  "minimum": 0
                },
                "pages_total": {
                  "type": "integer",
                  "minimum": 0
                },
                "pages_extracted": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "blocks",
                "characters",
                "pages_total",
                "pages_extracted"
