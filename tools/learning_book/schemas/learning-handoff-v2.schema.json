{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inspool:learning-handoff:2",
  "title": "含必需题目附件的只读学习交接包 /2",
  "description": "自有字段有明确类型；raw、detail、events、来源 metadata 为原始公开 JSON，保留扩展。校验不证明来源原文正确或学习掌握。",
  "$ref": "#/$defs/handoff",
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\:]+$"
    },
    "scope": {
      "type": "object",
      "required": [
        "deploymentId",
        "ownerId",
        "workspaceId",
        "scopeVerification",
        "kbScopeDigest",
        "configurationDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "deploymentId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "scopeVerification": {
          "enum": [
            "configured_single_user",
            "authenticated"
          ]
        },
        "kbScopeDigest": {
          "$ref": "#/$defs/sha"
        },
        "configurationDigest": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "rule",
        "limits",
        "used",
        "hits",
        "pendingRequest"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "const": "learning-read-limits/1"
        },
        "limits": {
          "$ref": "#/$defs/counters"
        },
        "used": {
          "$ref": "#/$defs/counters"
        },
        "hits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pendingRequest": {
          "type": "boolean"
        }
      }
    },
    "counters": {
      "type": "object",
      "required": [
        "sessions",
        "messages",
        "events",
        "eventPages",
        "requests",
        "readBytes",
        "packageBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "eventPages": {
          "type": "integer",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "readBytes": {
          "type": "integer",
          "minimum": 0
        },
        "packageBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "actor": {
      "type": "object",
      "required": [
        "actorId",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "user",
            "external_agent"
          ]
        }
      }
    },
    "declaration": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "schema",
        "attributedAuthor",
        "submittedBy",
        "scope",
        "declaredAt",
        "statement",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "enum": [
            "learning-collection-declaration/1",
            "learning-completion-declaration/1"
          ]
        },
        "attributedAuthor": {
          "$ref": "#/$defs/actor"
        },
        "submittedBy": {
          "$ref": "#/$defs/actor"
        },
        "scope": {
          "type": "object",
          "required": [
            "deploymentId",
            "ownerId",
            "workspaceId",
            "activityId",
            "bookId"
          ]
        },
        "declaredAt": {
          "type": "string",
          "format": "date-time"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "required": [
            "kind",
            "reference"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "operator_file",
                "agent_forwarded"
              ]
            },
            "reference": {
              "type": "string"
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "status",
        "currentCompletion",
        "attributionAssurance",
        "laterActivityObserved",
        "declaration"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "declared_complete",
            "agent_statement_only"
          ]
        },
        "currentCompletion": {
          "const": "unknown"
        },
        "attributionAssurance": {
          "const": "operator_supplied"
        },
        "laterActivityObserved": {
          "type": [
            "boolean",
            "string"
          ],
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "declaration": {
          "$ref": "#/$defs/declaration"
        },
        "timeAssurance": {
          "const": "reported_times_only"
        }
      }
    },
    "baselineEvidence": {
      "type": "object",
      "required": [
        "bindingStatus",
        "issues",
        "refMap",
        "sourceRetention",
        "snapshotId"
      ],
      "additionalProperties": false,
      "properties": {
        "bindingStatus": {
          "enum": [
            "accepted",
            "candidate",
            "missing",
            "invalid"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refMap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "oldRef",
              "artifact",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "oldRef": {
                "type": "string"
              },
              "artifact": {
                "$ref": "#/$defs/ref"
              },
              "sha256": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        "sourceRetention": {
          "const": "external"
        },
        "snapshotId": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "type": "object",
          "required": [
            "rule",
            "contentDigest",
            "resourceManifestDigest",
            "sourceMappingDigest"
          ]
        },
        "bindingRef": {
          "type": "string"
        },
        "reviewRequestRef": {
          "type": "string"
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "schema",
        "exporter",
        "exportId",
        "activityId",
        "bookId",
        "backendScope",
        "build",
        "recordedAt",
        "collectionStatus",
        "resultStatus",
        "roundsAttempted",
        "atomicSnapshot",
        "assurance",
        "submissionContent",
        "baselineEvidence",
        "sources",
        "collectionDeclaration",
        "completion",
        "currentCheckRef",
        "priorRoundObservationsRef",
        "coverage",
        "limits",
        "errors",
        "limitations",
        "questionEvidence"
      ],
      "additionalProperties": false,
      "properties": {
        "preparationEvidence": {
          "type": "object",
          "required": [
            "schema",
            "refMap",
            "sourceOriginalsVerified"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "learning-preparation-evidence/1"
            },
            "refMap": {
              "type": "array",
              "maxItems": 33,
              "items": {
                "type": "object",
                "required": [
                  "oldRef",
                  "artifact",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "oldRef": {
                    "type": "string"
                  },
                  "artifact": {
                    "$ref": "#/$defs/ref"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha"
                  }
                }
              }
            },
            "sourceOriginalsVerified": {
              "const": false
            }
          }
        },
        "schema": {
          "const": "learning-handoff/2"
        },
        "exporter": {
          "const": "learning-handoff-exporter/1"
        },
        "exportId": {
          "type": "string"
        },
        "activityId": {
          "type": "string"
        },
        "bookId": {
          "type": "string"
        },
        "backendScope": {
          "$ref": "#/$defs/scope"
        },
        "build": {
          "type": "object",
          "required": [
            "contentReadBuild",
            "learningStateReadBuild"
          ]
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "collectionStatus": {
          "enum": [
            "stable",
            "inconsistent"
          ]
        },
        "resultStatus": {
          "enum": [
            "succeeded",
            "partial"
          ]
        },
        "roundsAttempted": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "atomicSnapshot": {
          "const": false
        },
        "assurance": {
          "const": "cooperative"
        },
        "submissionContent": {
          "const": "unknown"
        },
        "baselineEvidence": {
          "$ref": "#/$defs/baselineEvidence"
        },
        "sources": {
          "type": "object",
          "required": [
            "retention",
            "statusAtCollection",
            "mapping"
          ],
          "properties": {
            "retention": {
              "const": "external"
            },
            "statusAtCollection": {
              "enum": [
                "complete",
                "partial",
                "unknown"
              ]
            },
            "mapping": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "collectionDeclaration": {
          "$ref": "#/$defs/declaration"
        },
        "completion": {
          "$ref": "#/$defs/completion"
        },
        "currentCheckRef": {
          "$ref": "#/$defs/ref"
        },
        "priorRoundObservationsRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "type": "object",
          "required": [
            "records",
            "content",
            "selectedConversations",
            "allHistoricalSessions",
            "history",
            "attachments"
          ],
          "properties": {
            "records": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "content": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "selectedConversations": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "allHistoricalSessions": {
              "const": "unknown"
            },
            "history": {
              "const": "partial"
            },
            "attachments": {
              "const": "references_only"
            }
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "errors": {
          "$ref": "#/$defs/errors"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questionEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/ref"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "contentReadRef": {
              "$ref": "#/$defs/ref"
            }
          },
          "required": [
            "path",
            "sha256",
            "contentReadRef"
          ]
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema",
        "exportId",
        "activityId",
        "backendScope",
        "requestDigest",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "learning-handoff/2"
        },
        "exportId": {
          "type": "string"
        },
        "activityId": {
          "type": "string"
        },
        "backendScope": {
          "$ref": "#/$defs/scope"
        },
        "requestDigest": {
          "$ref": "#/$defs/sha"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha"
          }
        }
      }
    },
    "presence": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "present"
          ],
          "additionalProperties": false,
          "properties": {
            "present": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "required": [
            "present",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "present": {
              "const": true
            },
            "value": {}
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "required": [
        "status",
        "assurance",
        "submissionContent",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "baseline_consistent",
            "unknown"
          ]
        },
        "assurance": {
          "const": "cooperative"
        },
        "submissionContent": {
          "const": "unknown"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "recordId",
        "identityQuality",
        "identity",
        "raw",
        "occurrences",
        "identityConflict",
        "assessments",
        "binding",
        "diagnostics",
        "assistance"
      ],
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "$ref": "#/$defs/sha"
        },
        "identityQuality": {
          "enum": [
            "stable",
            "legacy",
            "invalid"
          ]
        },
        "identity": {
          "type": "object",
          "required": [
            "rule"
          ]
        },
        "raw": {},
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rawRef",
              "responseSha256",
              "pointer",
              "arrayIndex",
              "observedAt"
            ],
            "additionalProperties": false,
            "properties": {
              "rawRef": {
                "$ref": "#/$defs/ref"
              },
              "responseSha256": {
                "$ref": "#/$defs/sha"
              },
              "pointer": {
                "type": "string",
                "pattern": "^/progress/value/quiz_attempts/[0-9]+$"
              },
              "arrayIndex": {
                "type": "integer",
                "minimum": 0
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "identityConflict": {
          "type": "boolean"
        },
        "assessments": {
          "type": "object",
          "required": [
            "raw",
            "comparisonToBaseline",
            "assessmentSync"
          ],
          "additionalProperties": false,
          "properties": {
            "raw": {
              "type": "object",
              "required": [
                "method",
                "isCorrect",
                "transportSource"
              ],
              "additionalProperties": false,
              "properties": {
                "method": {
                  "enum": [
                    "unknown",
                    "client_reported",
                    "user_self_report",
                    "ungraded"
                  ]
                },
                "isCorrect": {
                  "$ref": "#/$defs/presence"
                },
                "transportSource": {
                  "enum": [
                    "client_reported",
                    "unknown"
                  ]
                }
              }
            },
            "comparisonToBaseline": {
              "type": "object",
              "required": [
                "rule",
                "result",
                "historicalBinding",
                "snapshotId"
              ],
              "properties": {
                "rule": {
                  "const": "choice-key/1"
                },
                "result": {
                  "enum": [
                    "correct",
                    "incorrect",
                    "unknown"
                  ]
                },
                "historicalBinding": {
                  "const": "unknown"
                },
                "snapshotId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "assessmentSync": {
              "const": "unknown"
            },
            "typeBasis": {
              "type": "object",
              "required": [
                "snapshotId",
                "questionType",
                "historicalBinding"
              ]
            }
          }
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assistance": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "observed"
              ]
            }
          }
        }
      }
    },
    "records": {
      "type": "object",
      "required": [
        "schema",
        "recordScopeId",
        "scope",
        "bookId",
        "readerScopes",
        "records",
        "missingAttemptObservations",
        "upstreamSummaries",
        "progressObservations",
        "recordCoverage",
        "logicalAttemptCount",
        "clockAssumption",
        "errors",
        "rejectedObservations",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "learning-records/1"
        },
        "recordScopeId": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "bookId": {
          "type": "string"
        },
        "readerScopes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "actorId",
              "workspaceId",
              "identityKind"
            ]
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "missingAttemptObservations": {
          "type": "array"
        },
        "upstreamSummaries": {
          "type": "array"
        },
        "progressObservations": {
          "type": "array"
        },
        "recordCoverage": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "logicalAttemptCount": {
          "const": "unknown"
        },
        "clockAssumption": {
          "type": [
            "object",
            "null"
          ]
        },
        "errors": {
          "$ref": "#/$defs/errors"
        },
        "rejectedObservations": {
          "$ref": "#/$defs/errors"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conversations": {
      "type": "object",
      "required": [
        "schema",
        "bookId",
        "selection",
        "sessions",
        "errors",
        "unvisitedSessions",
        "allHistoricalSessions",
        "historyCoverage",
        "boundaryVerified",
        "assistance",
        "boundaries",
        "verificationReads",
        "selectedCoverage"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "learning-conversations/1"
        },
        "bookId": {
          "type": "string"
        },
        "selection": {
          "type": "array"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sessionId",
              "bookId",
              "pageIds",
              "selectionSources",
              "status",
              "errors",
              "eventTraces",
              "reads"
            ],
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "bookId": {
                "type": "string"
              },
              "pageIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "succeeded",
                  "partial"
                ]
              },
              "detail": {
                "type": "object"
              },
              "eventTraces": {
                "type": "array"
              },
              "messageKeys": {
                "type": "array"
              },
              "errors": {
                "$ref": "#/$defs/errors"
              }
            }
          }
        },
        "errors": {
          "$ref": "#/$defs/errors"
        },
        "unvisitedSessions": {
          "type": "array"
        },
        "allHistoricalSessions": {
          "const": "unknown"
        },
        "historyCoverage": {
          "const": "partial"
        },
        "boundaryVerified": {
          "type": "boolean"
        },
        "assistance": {
          "type": "object"
        },
        "boundaries": {
          "type": "array"
        },
        "verificationReads": {
          "type": "array"
        },
        "selectedCoverage": {
          "enum": [
            "complete",
            "partial"
          ]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "schema",
        "exportId",
        "activityId",
        "status",
        "code",
        "limits",
        "validHandoffPublished",
        "attemptRef"
      ],
      "properties": {
        "schema": {
          "const": "learning-handoff-diagnostic/1"
        },
        "status": {
          "const": "partial"
        },
        "validHandoffPublished": {
          "const": false
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "attemptRef": {
          "$ref": "#/$defs/ref"
        }
      }
    }
  }
}
