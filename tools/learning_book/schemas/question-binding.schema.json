{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "learning-question-binding/1"
    },
    "specDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lessonRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "lessonSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "sourceVersionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "sourceId",
          "sourceVersionId",
          "sha256"
        ]
      }
    },
    "mode": {
      "enum": [
        "authored",
        "variant"
      ]
    },
    "questionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "questionDigests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxProperties": 8
    },
    "preparationDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "specDigest",
    "lessonRef",
    "lessonSha256",
    "sources",
    "mode",
    "questionIds",
    "questionDigests",
    "preparationDigest",
    "reviewDigest"
  ],
  "x-relationalRules": [
    "来源与题目 ID 唯一，来源引用闭合；authored 摘要完整匹配，variant 生成前为空；题目摘要包含选项显示顺序。"
  ]
}
