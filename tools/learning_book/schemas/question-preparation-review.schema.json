{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "learning-question-preparation-review/1"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "specDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "authored",
        "variant"
      ]
    },
    "decision": {
      "const": "reviewed_for_production"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "questionId",
          "contentDigest",
          "reason"
        ]
      }
    },
    "assurance": {
      "const": "operator_supplied"
    }
  },
  "required": [
    "schema",
    "reviewId",
    "reviewedBy",
    "specDigest",
    "mode",
    "decision",
    "checks",
    "assurance"
  ]
}
